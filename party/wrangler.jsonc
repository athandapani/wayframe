{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayframe-party",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "PortfolioRoom",
        "class_name": "PortfolioRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PortfolioRoom"]
    }
  ]
}
